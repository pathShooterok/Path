{
  "cache": {
    "enabled": true,
    "ttl": 3600,
    "dir": ".path_cache"
  },
  "sources": {
    "order": ["duckduckgo", "bing", "google"],
    "delay_between": 1.0,
    "parallel": true,
    "duckduckgo": { "enabled": true, "limit": 10 },
    "bing": { "enabled": true, "limit": 10, "require_target_match": false },
    "google": { "enabled": false, "limit": 10 }
  },
  "trace": {
    "queries": ["\"{target}\""],
    "require_target_in_result": true,
    "scan_social_profiles": true,
    "max_profiles": 5,
    "min_profile_match": "normalized"
  },
  "profiles": {
    "enabled": true,
    "platforms": ["GitHub", "GitLab", "Habr", "Keybase", "DEV", "Pikabu", "Telegram", "HackerNews", "DockerHub", "Bluesky", "Lichess", "Chess.com", "Codeberg", "Mastodon", "Gravatar"],
    "github_api": true,
    "workers": 6,
    "try_variants": true
  },
  "cleanup": {
    "enabled": true,
    "drop_test_emails": true,
    "drop_junk_text": true,
    "max_value_length": 300
  },
  "scan": {
    "max_linked_pages": 10,
    "follow_social_links": true,
    "discord_invites": true,
    "max_discord_invites": 3
  },
  "http": {
    "timeout": 10,
    "retries": 2
  }
}
